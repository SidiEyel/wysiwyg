{
  "name": "@/wysiwyg-editor",
  "version": "1.0.0",
  "description": "A modern WYSIWYG editor built with React and Tiptap",
  "type": "module",
  "main": "./dist/wysiwyg-editor.umd.js",
  "module": "./dist/wysiwyg-editor.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wysiwyg-editor.es.js",
      "require": "./dist/wysiwyg-editor.umd.js"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "wysiwyg",
    "editor",
    "rich-text",
    "tiptap",
    "text-editor"
  ],
  "author": "Sidi Eyel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidieyel/wysiwyg"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-text-align": "^3.7.2",
    "@tiptap/extension-underline": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "lucide-react": "^0.454.0",
    "@radix-ui/react-separator": "1.1.7",
    "path": "0.12.7",
    "tw-animate-css": "1.4.0",
    "next": "16.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "@types/node": "24.9.1",
    "tailwindcss": "4.1.15",
    "postcss": "8.5.6"
  }
}
