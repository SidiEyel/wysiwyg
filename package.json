{
  "name": "@sidi-eyel/wysiwyg-editor",
  "version": "1.0.0",
  "description": "A modern WYSIWYG editor built with React and Tiptap",
  "type": "module",
  "main": "./dist/wysiwyg-editor.cjs",
  "module": "./dist/wysiwyg-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wysiwyg-editor.js",
      "require": "./dist/wysiwyg-editor.cjs"
    },
    "./styles": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "wysiwyg",
    "editor",
    "rich-text",
    "tiptap",
    "text-editor",
    "react-component"
  ],
  "author": "Sidi Eyel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidiEyel/wysiwyg.git"
  },
  "homepage": "https://github.com/SidiEyel/wysiwyg#readme",
  "bugs": {
    "url": "https://github.com/SidiEyel/wysiwyg/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-text-align": "^3.7.2",
    "@tiptap/extension-underline": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "lucide-react": "^0.454.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  }
}
